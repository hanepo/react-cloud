rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function to check user role
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return hasRole('admin');
    }
    
    // Helper function to check if user is editor or admin
    function canEdit() {
      return hasRole('admin') || hasRole('editor');
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      allow read: if isAuthenticated() && request.auth.uid == userId;
      
      // Only admins can read all users
      allow read: if isAdmin();
      
      // Users can create their own document on signup
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // Users can update their own document (for 2FA, profile, etc.)
      allow update: if isAuthenticated() && request.auth.uid == userId;
      
      // Only admins can update user roles and delete users
      allow update, delete: if isAdmin();
    }
    
    // Files collection - RBAC implementation
    match /files/{fileId} {
      // Helper function to check if user has access to file
      function hasFileAccess(fileData) {
        // Owner always has access
        let isOwner = request.auth.uid == fileData.uploadedBy;
        
        // Check if user is in allowedUsers array
        let isAllowedUser = request.auth.uid in fileData.allowedUsers;
        
        // Check if user's role is in allowedRoles array
        let hasAllowedRole = getUserData().role in fileData.allowedRoles;
        
        // Admin always has access to all files
        let isAdminUser = isAdmin();
        
        return isOwner || isAllowedUser || hasAllowedRole || isAdminUser;
      }
      
      // Read: Owner, users in allowedUsers, users with roles in allowedRoles, or admin
      allow read: if isAuthenticated() && hasFileAccess(resource.data);
      
      // Create: Only authenticated users with editor or admin role
      allow create: if isAuthenticated() && canEdit() 
                    && request.resource.data.uploadedBy == request.auth.uid
                    && request.resource.data.allowedUsers is list
                    && request.resource.data.allowedRoles is list;
      
      // Update: Owner or admin can update
      allow update: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || isAdmin()
      );
      
      // Delete: Owner or admin can delete
      allow delete: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || isAdmin()
      );
    }
    
    // Folders collection
    match /folders/{folderId} {
      // Helper function to check folder access
      function hasFolderAccess(folderData) {
        let isOwner = request.auth.uid == folderData.createdBy;
        let isAdminUser = isAdmin();
        return isOwner || isAdminUser;
      }
      
      // Read: Owner or admin
      allow read: if isAuthenticated() && hasFolderAccess(resource.data);
      
      // Create: Editor or admin can create folders
      allow create: if isAuthenticated() && canEdit()
                    && request.resource.data.createdBy == request.auth.uid;
      
      // Update/Delete: Owner or admin
      allow update, delete: if isAuthenticated() && hasFolderAccess(resource.data);
    }
    
    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}